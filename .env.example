# Пример окружения для демо. Скопируйте в .env (он в .gitignore) и заполните нужное.
# Сервер .env сам не читает — загрузите перед запуском:
#   bash/zsh:   set -a; . ./.env; set +a; python3 run.py
#   PowerShell: Get-Content .env | Where-Object { $_ -match '^[A-Z_]+=' } | ForEach-Object { $k, $v = $_ -split '=', 2; Set-Item "env:$k" $v }; python run.py

# --- сервис и демо ---
DASHBOARD_TOKEN=demo
# для demo_traffic.py: доверять X-Forwarded-For от 127.0.0.1 (каждый «пользователь» — свой IP)
OTP_TRUSTED_PROXIES=127.0.0.1

# --- сводка инцидента через LLM (по умолчанию выключена) ---
# Цепочка провайдеров по порядку; кто не ответил или не прошёл проверку фактов — следующий, в конце шаблон.
# Пресеты: groq, gemini, openrouter, ollama, anthropic
RISK_LLM_PROVIDERS=

# Groq — бесплатно, без карты: https://console.groq.com/keys  (основной, очень быстрый)
RISK_LLM_GROQ_KEY=
# Google Gemini — бесплатно: https://aistudio.google.com/apikey
#   (бесплатный тариф может использовать запросы для улучшения продуктов Google; наружу уходят только агрегаты)
RISK_LLM_GEMINI_KEY=
# OpenRouter — бесплатные модели: https://openrouter.ai/keys  (~20 запросов/мин, ~50 в сутки)
RISK_LLM_OPENROUTER_KEY=
# Ollama — локально, ключ не нужен: установите https://ollama.com и выполните `ollama pull qwen2.5:7b`
# Anthropic — платно: https://console.anthropic.com/
RISK_LLM_ANTHROPIC_KEY=

# Необязательно: переопределить модель и адрес первого провайдера цепочки
RISK_LLM_MODEL=
RISK_LLM_BASE_URL=
# Таймаут одного провайдера (с); вся цепочка — не дольше 2 × таймаут
RISK_LLM_TIMEOUT=6
# Кеш сводки, с
RISK_LLM_CACHE_SECONDS=30
